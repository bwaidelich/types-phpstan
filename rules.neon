rules:
  - Wwwision\TypesPhpStan\TypedClassesMustNotBeConstructedRule
  - Wwwision\TypesPhpStan\TypedClassesMustHavePrivateConstructorRule
  - Wwwision\TypesPhpStan\TypedClassesMustBeFinalRule
  - Wwwision\TypesPhpStan\TypedClassesMustBeReadonlyRule

services:
  -
    class: Wwwision\TypesPhpStan\DynamicRecordPropertiesClassReflectionExtension
    tags:
      - phpstan.broker.propertiesClassReflectionExtension
